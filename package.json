{
  "name": "email-triage-badi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "oxlint src tests scripts web",
    "format": "oxfmt src tests scripts web",
    "format:check": "oxfmt --check src tests scripts web",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "vitest run && vitest run --config vitest.web.config.ts",
    "test:api": "vitest run",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "evaluate": "vitest run --config vitest.live.config.ts tests/live/evaluate.test.ts",
    "build": "bun run web:build && wrangler deploy --dry-run",
    "build:worker": "wrangler deploy --dry-run",
    "web:build": "vite build web --config web/vite.config.ts",
    "web:dev": "vite web --config web/vite.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply email-triage-badi --local",
    "db:migrate:remote": "wrangler d1 migrations apply email-triage-badi --remote",
    "oauth:bootstrap": "bun run scripts/oauth-bootstrap.ts",
    "oauth:check": "bun run scripts/oauth-bootstrap.ts --check",
    "labels:inventory": "bun run scripts/label-inventory.ts",
    "deploy": "bun run web:build && wrangler deploy --env production"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "htmlparser2": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "google-auth-library": "^11.1.0",
    "jsdom": "^30.1.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2",
    "ultracite": "^7.12.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3"
}
